{
	"name": "medansoftware/c45-algorithm-php",
	"type": "library",
	"description": "C4.5 decision tree algorithm implementation in PHP",
	"license": "MIT",
	"authors": [
		{
			"name": "Agung Dirgantara",
			"email": "agungmasda29@gmail.com"
		}
	],
	"require": {
		"php": "^8.1",
		"phpoffice/phpspreadsheet": "^2.0 || ^3.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"autoload": {
		"psr-4": {
			"Algorithm\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Algorithm\\C45\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit --colors=always"
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}